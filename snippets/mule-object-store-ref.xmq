    {
        os:remove(doc:name = Remove
                  doc:id   = dfe970ba-7dfe-4a15-9e73-73701e58647f)
    }
    flow(name   = tempFlow3
         doc:id = 259d8880-9ecb-4a0a-aed0-ed585b31307b)
    {
        os:retrieve(doc:name = Retrieve
                    doc:id   = e1c274d8-fbe7-4f76-87cc-6b65be4230a4)
