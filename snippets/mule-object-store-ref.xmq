    flow(name   = tempFlow5
         doc:id = 6425078e-9eff-462f-bf5d-fce33196f40d)
    {
        os:retrieve-all-keys(doc:name = 'Retrieve all keys'
                             doc:id   = 489de73a-00bf-4d00-8de1-a3828bd0038b)
    }
    flow(name   = tempFlow6
         doc:id = 11e66ff4-fa2a-42d3-a546-cfb181dd1534)
    {
        os:store(doc:name = Store
                 doc:id   = 3035fb6e-5b4b-486e-9cc2-78160270b2ee)
    }
    flow(name   = tempFlow1
         doc:id = 70b6e766-6f77-4e99-94a4-941f312210a1)
    {
        os:contains(doc:name = Contains
                    doc:id   = c82302ee-6ca7-45ab-ad77-2ddf2c7a340c)
    }
