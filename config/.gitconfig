
[user]
	name = {name}
	email = {email}
[credential]
	helper = store
[init]
	defaultBranch = main
[diff]
	tool = vimdiff
[merge]
	tool = vimdiff
[difftool]
	prompt = false
	symlinks = false
[core]
	autocrlf = input
[mergetool]
	keepBackup = false
[push]
  autoSetupRemote = true
[difftool "vimdiff"]
	cmd = vimdiff \"$LOCAL\" \"$REMOTE\"
